# ==============================================================================
# A3 AlphaEdge PRO HFT Engine v5.0 (Proyecto Agustín) — Configuración de Entorno
# ==============================================================================

# Puerto del Dashboard Web
PORT=8005

# Modo de Datos de Mercado (true = Bybit L2 en vivo, false = simulación sintética)
LIVE_MODE=true

# Inicio automático del motor al iniciar el servidor
AUTO_START_ENGINE=true

# ==============================================================================
# Notificaciones en Tiempo Real por Telegram
# ==============================================================================
# Obtén tu Bot Token hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# Obtén tu Chat ID hablando con @userinfobot o mediante tu grupo/canal
TELEGRAM_CHAT_ID=

# Habilitar o silenciar notificaciones (true/false)
TELEGRAM_ENABLED=true

# ==============================================================================
# Conexión Segura al Exchange (Bybit / KuCoin / Binance)
# ==============================================================================
# Exchange objetivo: bybit, kucoin o binance
EXCHANGE_NAME=bybit

# Claves de API de tu cuenta en el Exchange
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Guardia de Seguridad Zero-Trust:
# false = DRY-RUN (simula órdenes en el exchange sin arriesgar saldo real)
# true  = OPERACIONES REALES CON CAPITAL EN EL EXCHANGE
LIVE_TRADING_ENABLED=false
